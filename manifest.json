{
  "manifest_version": 3,
  "name": "Tab Reopen",
  "description": "Reopen closed tabs",
  "version": "1.0",
  "icons": {
    "16": "images/gear.png",
    "32": "images/gear.png",
    "48": "images/gear.png",
    "128": "images/gear.png"
  },
  "action": {
    "default_popup": "test.html",
    "default_icon": "images/gear.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "incognito": "split",
  "permissions": ["tabs", "storage"],
  "commands": {
    "reopen-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "reopen closed tab"
    }
  },
  "minimum_chrome_version": "102"
}
